rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;

      // API credentials are written/read only by the trusted server using Firebase Admin.
      // Never expose encrypted credential documents to the browser.
      match /aiConnections/{providerId} {
        allow read, write: if false;
      }
    }
  }
}
