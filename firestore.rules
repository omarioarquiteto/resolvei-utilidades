rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberOfList(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/shoppingLists/$(listId)).data.memberIds;
    }

    function memberOfListAfter(listId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/shoppingLists/$(listId)).data.memberIds;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /aiConnections/{providerId} {
        allow read, write: if false;
      }
    }

    /*
     * Lista de Compras:
     * - cada lista pertence a um criador e pode ter vários membros;
     * - o link compartilhado é um "bearer link": quem tiver o ID e estiver
     *   autenticado pode entrar na lista;
     * - depois de entrar, apenas membros podem ler/alterar os produtos.
     */
    match /shoppingLists/{listId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.memberIds
          || resource.data.shareEnabled == true
        );

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.shareEnabled == resource.data.shareEnabled
        )
        ||
        (
          resource.data.shareEnabled == true
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read, create, update, delete: if memberOfList(listId);
      }
    }
  }
}
