{
  "manifest_version": 3,
  "name": "Resolvei — Comparador de Preços",
  "version": "2.0.0",
  "description": "Compare preços, frete, parcelamento e cupons. Contribua com a base comunitária de ofertas do Resolvei.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://resolvei-utilidades.onrender.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "action": {
    "default_title": "Resolvei — Comparador de Preços",
    "default_popup": "popup.html"
  }
}
