# =========================
# Resolvei — backend / IA / mercado
# =========================

# IA padrão do servidor (ferramentas que usam OpenAI internamente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Gemini do próprio Resolvei.
# Usuários autenticados pelo Google/Firebase poderão usar o Gemini sem cadastrar uma chave pessoal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pesquisa de preços regionais / Google Shopping
SERPAPI_KEY=

# Dados de mercado usados pela análise de opções binárias
TWELVE_DATA_API_KEY=

# =========================
# Firebase Admin (backend)
# =========================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Chave Base64URL de 32 bytes usada para criptografar as API keys
# salvas no Firestore.
RESOLVEI_CREDENTIAL_ENCRYPTION_KEY=
