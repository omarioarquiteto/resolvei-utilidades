# =========================
# Resolvei — backend / IA / mercado
# =========================

# IA padrão do servidor (ferramentas que usam OpenAI internamente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Gemini do próprio Resolvei.
# Usuários autenticados pelo Google/Firebase poderão usar o Gemini sem cadastrar uma chave pessoal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# IA alternativa do Consultor Sênior — Groq primeiro, OpenRouter em fallback.
# As chaves devem ser cadastradas somente nas Environment Variables do Render.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Pesquisa de preços regionais / Google Shopping
SERPAPI_KEY=

# Dados de mercado usados pela análise de opções binárias
TWELVE_DATA_API_KEY=

# =========================
# Firebase Admin (backend)
# =========================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket do Firebase Storage usado para guardar imagens de capa e imagens dos artigos.
FIREBASE_STORAGE_BUCKET=resolvei-c95d1.firebasestorage.app

# Acesso exclusivo ao painel editorial. Preencha apenas um dos campos:
# BLOG_ADMIN_EMAIL: e-mail verificado usado no login do Resolvei.
# BLOG_ADMIN_UID: UID Firebase da conta administradora (opção mais restrita).
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_UID=

# Chave Base64URL de 32 bytes usada para criptografar as API keys
# salvas no Firestore.
RESOLVEI_CREDENTIAL_ENCRYPTION_KEY=

# URL público do backend FastAPI que a Netlify vai proxyar em /api/*
RESOLVEI_BACKEND_URL=
